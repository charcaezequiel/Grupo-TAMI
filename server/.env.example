# Configuración del servidor TAMI
PORT=3000
NODE_ENV=development

# Base de datos PostgreSQL
DATABASE_URL=postgresql://usuario:password@localhost:5432/tami

# CORS (orígenes permitidos separados por coma). Se aceptan http://localhost:puerto
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# Detrás de proxy/balanceador (true/false)
TRUST_PROXY=false

# Clave para endpoints administrativos (usar una clave larga y aleatoria)
ADMIN_KEY=

# Rate limiting
LIMITE_GLOBAL=300
LIMITE_AUTH=30
LIMITE_CAMBIOS_CUENTA=20
LIMITE_RECUPERACION=5
LIMITE_RESTABLECER=10

# Seguridad de login
MAX_INTENTOS_LOGIN=5
VENTANA_BLOQUEO_LOGIN=15

# Recuperación de contraseña con SMTP (Gmail / otros)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=tu_correo@gmail.com
SMTP_PASS=tu_contraseña_de_aplicacion
SMTP_FROM=TAMI <tu_correo@gmail.com>
FRONTEND_URL=http://localhost:5500/code/index.html
RESET_TOKEN_MINUTOS=30
# Solo para desarrollo: muestra el enlace en la respuesta si no hay SMTP o para pruebas
RESET_DEBUG_LINK=false
