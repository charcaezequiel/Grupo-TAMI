# Supabase (pooler) - copiar este archivo a .env y completar los valores
DB_HOST=aws-0-us-east-1.pooler.supabase.com
DB_PORT=5432
DB_USER=postgres.XXXXXXXXXXXXXXXX
DB_PASSWORD=tu-password-de-supabase
DB_NAME=postgres
DB_SSL=true
PORT=3000

# Seguridad de la API (opcionales)
# Clave para acceder a los listados completos de usuarios (cabecera x-api-key).
# Si se deja vacía, esos listados NO exponen los correos.
ADMIN_KEY=
# Límites de solicitudes por IP (por minuto)
LIMITE_GLOBAL=300
LIMITE_AUTH=30
# Protección de fuerza bruta en el login
MAX_INTENTOS_LOGIN=5
VENTANA_BLOQUEO_LOGIN=15
# Límites de recuperación de contraseña (por IP, cada 15 minutos)
LIMITE_RECUPERACION=5
LIMITE_RESTABLECER=10
# Orígenes extra permitidos en CORS, separados por coma (los locales ya están permitidos)
CORS_ORIGINS=

# Recuperación de contraseña por correo
# URL completa del frontend que recibe el enlace. En producción usar HTTPS.
FRONTEND_URL=http://localhost:5500/code/index.html
# Minutos que vale el enlace (entre 5 y 120)
RESET_TOKEN_MINUTOS=30
# SMTP: Gmail, Outlook, Brevo, Mailgun, SES, etc.
# Gmail requiere una "contraseña de aplicación" (no la clave normal).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=TAMI <no-reply@tami.local>
# Solo para desarrollo local: devuelve el enlace en la respuesta de la API
# cuando SMTP no está configurado. NUNCA activar en producción.
RESET_DEBUG_LINK=false

# Alternativa: cadena de conexión completa (tiene prioridad si está definida)
# DATABASE_URL=postgresql://postgres.XXXXX:password@aws-0-us-east-1.pooler.supabase.com:5432/postgres
