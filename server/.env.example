# Configuración del servidor TAMI
PORT=3000
NODE_ENV=development

# Base de datos PostgreSQL (local o Supabase)
# Formato Supabase: postgresql://usuario:password@host:5432/postgres
DATABASE_URL=postgresql://usuario:password@localhost:5432/tami
# Supabase exige SSL. Poner false solo en una base local sin SSL.
DB_SSL=true

# CORS (orígenes permitidos separados por coma). Se aceptan http://localhost:puerto
CORS_ORIGINS=http://localhost:3000,http://localhost:5500

# Detrás de proxy/balanceador (true/false)
TRUST_PROXY=false

# Firma de los tokens de sesión (JWT).
# Generar una clave larga y aleatoria, por ejemplo:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambiar_por_una_clave_larga_y_aleatoria
JWT_DURACION_MINUTOS=720

# Clave para endpoints administrativos de emergencia (usar una clave larga y aleatoria)
ADMIN_KEY=

# Rate limiting
LIMITE_GLOBAL=300
LIMITE_AUTH=30
LIMITE_CAMBIOS_CUENTA=20
LIMITE_RECUPERACION=5
LIMITE_RESTABLECER=10

# Seguridad de login
MAX_INTENTOS_LOGIN=5
VENTANA_BLOQUEO_LOGIN=15

# Recuperación de contraseña con SMTP (Brevo, Gmail, Outlook, etc.)
# Brevo: host smtp-relay.brevo.com, puerto 587, usuario y clave SMTP del panel.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=tu_usuario_smtp
SMTP_PASS=tu_clave_smtp
SMTP_FROM=TAMI <tu_correo_verificado>
FRONTEND_URL=http://localhost:3000/
RESET_TOKEN_MINUTOS=30
# Solo para desarrollo: muestra el enlace en la respuesta si no hay SMTP o para pruebas
RESET_DEBUG_LINK=false
