{
  "name": "grupo-tami-server",
  "version": "1.0.0",
  "description": "Backend Node.js + Express + PostgreSQL del proyecto TAMI",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "dev": "node --watch index.js",
    "db:check": "node -e \"require('./db').verificarConexion().then(o=>process.exit(o?0:1))\"",
    "db:estado": "node scripts/estado.js",
    "db:migrate": "node scripts/migrate.js",
    "db:seed": "node scripts/seed.js",
    "db:seguridad": "node scripts/seguridad.js",
    "db:rbac": "node scripts/rbac-apply.js",
    "db:rbac:full": "node scripts/migrar-rbac-seguridad.js"
  },
  "keywords": [
    "tami",
    "node",
    "express",
    "postgresql"
  ],
  "license": "ISC",
  "dependencies": {
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "nodemailer": "^7.0.13",
    "pg": "^8.12.0"
  }
}
